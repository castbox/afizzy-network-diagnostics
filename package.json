{
  "name": "afizzy-network-diagnostics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare:config": "node scripts/config.mjs",
    "dev": "npm run prepare:config && vite --host 127.0.0.1",
    "build": "npm run prepare:config && tsc --noEmit && vite build",
